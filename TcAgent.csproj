<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TcAgent</AssemblyName>
    <RootNamespace>TcAgent</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- fixed package versions (licenses checked for exactly these, see THIRD-PARTY-NOTICES.md); packages.lock.json is
         committed so every build ships the same dependencies. After changing a version: dotnet restore --force-evaluate -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NoWarn>CA1416;CS8632</NoWarn>
    <!-- false for the VSIX build: the interop is not shipped but generated on the target machine (InteropResolver.cs) -->
    <InteropPrivate Condition="'$(InteropPrivate)'==''">true</InteropPrivate>
  </PropertyGroup>
  <ItemGroup>
    <!-- the VS extension is built separately with vsbridge\build.ps1 (.NET Framework) -->
    <Compile Remove="vsbridge\**" />
    <Compile Remove="bin\**;obj\**" />
    <!-- unit tests are a project of their own (tests\TcAgent.Tests) -->
    <Compile Remove="tests\**" />
    <None Remove="tests\**" />
  </ItemGroup>
  <ItemGroup>
    <!-- interop for the TwinCAT Automation Interface; generated by build.ps1 via tlbimp from TCatSysManager.tlb -->
    <Reference Include="Interop.TCatSysManagerLib">
      <HintPath>lib\Interop.TCatSysManagerLib.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>$(InteropPrivate)</Private>
    </Reference>
    <PackageReference Include="EnvDTE" Version="17.0.32112.339" />
    <PackageReference Include="EnvDTE80" Version="17.0.32112.339" />
    <PackageReference Include="Beckhoff.TwinCAT.Ads" Version="6.1.332" />
    <!-- PDF text for tc_docs (Apache-2.0) -->
    <PackageReference Include="PdfPig" Version="0.1.16" />
  </ItemGroup>
  <!-- VSIX build (InteropPrivate=false): Visual Studio automation assemblies may not be redistributed (Microsoft license) -
       they are loaded at runtime from the user's Visual Studio installation (InteropResolver.cs). -->
  <Target Name="ExcludeVsAssembliesFromVsix" AfterTargets="ComputeResolvedFilesToPublishList" Condition="'$(InteropPrivate)' == 'false'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
        Condition="'%(Filename)' == 'envdte' Or '%(Filename)' == 'envdte80' Or '%(Filename)' == 'Microsoft.VisualStudio.Interop' Or $([System.String]::Copy('%(Filename)').StartsWith('Interop.'))" />
    </ItemGroup>
  </Target>
</Project>
