<Project Sdk="Microsoft.NET.Sdk">
  <!-- Unit tests for the parts of TcAgent that need no TwinCAT/Visual Studio (pure file logic). The sources are linked,
       not referenced: the server project needs the TwinCAT interop and Windows, these tests run anywhere with .NET 8.
       Run: dotnet test tests\TcAgent.Tests -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>TcAgent.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\src\PlainText.cs" Link="src\PlainText.cs" />
    <Compile Include="..\..\src\TcUnitDiscovery.cs" Link="src\TcUnitDiscovery.cs" />
    <Compile Include="..\..\src\Guards.cs" Link="src\Guards.cs" />
    <Compile Include="..\..\src\AskQuestions.cs" Link="src\AskQuestions.cs" />
    <Compile Include="..\..\src\KnowledgeLayers.cs" Link="src\KnowledgeLayers.cs" />
    <Compile Include="..\..\src\Skills.cs" Link="src\Skills.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
</Project>
